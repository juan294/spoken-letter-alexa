{
  "schema_version": 1,
  "integration_branch": "develop",
  "remote": "origin",
  "verification_command": [
    "python3",
    ".rpi/scripts/rpi-verify.py"
  ],
  "verification_checks": [
    {
      "name": "typecheck",
      "argv": [
        "pnpm",
        "typecheck"
      ]
    },
    {
      "name": "lint",
      "argv": [
        "pnpm",
        "lint"
      ]
    },
    {
      "name": "test",
      "argv": [
        "pnpm",
        "test"
      ]
    },
    {
      "name": "cdk-synth",
      "argv": [
        "pnpm",
        "-F",
        "infra",
        "synth"
      ]
    },
    {
      "name": "e2e",
      "argv": [
        "pnpm",
        "test:e2e"
      ]
    }
  ]
}
