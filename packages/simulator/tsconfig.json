{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "e2e/**/*.ts",
    "eslint-rules/**/*.ts",
    "eslint-rules/**/*.mjs",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
