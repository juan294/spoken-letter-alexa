{
  "type": "APL",
  "version": "2024.3",
  "theme": "dark",
  "description": "Spoken Letter teleprompter: the script in large type, a 3-2-1 countdown overlay, a recording indicator and a Done button. In preview (before \"record\") the overlay and the button are hidden and the script scrolls by touch. Target: hub landscape small (960x480) and up.",
  "mainTemplate": {
    "parameters": ["payload"],
    "items": [
      {
        "type": "Container",
        "width": "100vw",
        "height": "100vh",
        "items": [
          {
            "type": "Container",
            "width": "100vw",
            "height": "100vh",
            "backgroundColor": "#2E2738",
            "items": [
              {
                "type": "Container",
                "direction": "row",
                "alignItems": "center",
                "height": "72dp",
                "paddingLeft": "32dp",
                "paddingRight": "24dp",
                "items": [
                  {
                    "type": "Text",
                    "text": "${payload.teleprompter.title}",
                    "color": "#F7F1E7",
                    "fontSize": "24dp",
                    "grow": 1,
                    "shrink": 1,
                    "maxLines": 1
                  },
                  {
                    "type": "Container",
                    "id": "recordingIndicator",
                    "opacity": 0,
                    "direction": "row",
                    "alignItems": "center",
                    "paddingRight": "24dp",
                    "items": [
                      { "type": "Frame", "width": "16dp", "height": "16dp", "borderRadius": "8dp", "backgroundColor": "#C8826F" },
                      { "type": "Text", "text": "${payload.teleprompter.recordingLabel}", "color": "#F7F1E7", "fontSize": "20dp", "paddingLeft": "8dp" }
                    ]
                  },
                  {
                    "type": "TouchWrapper",
                    "id": "doneButton",
                    "display": "${payload.teleprompter.preview ? 'none' : 'normal'}",
                    "onPress": [{ "type": "SendEvent", "arguments": ["done"] }],
                    "item": {
                      "type": "Frame",
                      "backgroundColor": "#E4A45C",
                      "borderRadius": "24dp",
                      "paddingLeft": "28dp",
                      "paddingRight": "28dp",
                      "paddingTop": "10dp",
                      "paddingBottom": "10dp",
                      "item": { "type": "Text", "text": "${payload.teleprompter.doneLabel}", "color": "#2E2738", "fontSize": "22dp", "fontWeight": "bold" }
                    }
                  }
                ]
              },
              {
                "type": "ScrollView",
                "id": "scriptScroll",
                "grow": 1,
                "shrink": 1,
                "paddingLeft": "48dp",
                "paddingRight": "48dp",
                "item": {
                  "type": "Text",
                  "text": "${payload.teleprompter.script}",
                  "color": "#F7F1E7",
                  "fontSize": "56dp",
                  "lineHeight": 1.25
                }
              }
            ]
          },
          {
            "type": "Frame",
            "id": "countdownOverlay",
            "display": "${payload.teleprompter.preview ? 'none' : 'normal'}",
            "position": "absolute",
            "top": 0,
            "left": 0,
            "width": "100vw",
            "height": "100vh",
            "backgroundColor": "rgba(46, 39, 56, 0.88)",
            "item": {
              "type": "Text",
              "id": "countdown",
              "text": "3",
              "width": "100vw",
              "height": "100vh",
              "textAlign": "center",
              "textAlignVertical": "center",
              "color": "#E4A45C",
              "fontSize": "180dp",
              "fontWeight": "bold"
            }
          }
        ]
      }
    ]
  }
}
