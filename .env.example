# Spoken Letter for Alexa+ — local development environment (packages/mcp-server/src/env.ts)
# Every value is optional locally: the server generates and prints what is missing.

# Public origin and OAuth issuer. Locally http://localhost:<PORT>; in AWS https://alexa.spokenletter.com
PUBLIC_BASE_URL=http://localhost:4310
PORT=4310

# Where the private Spoken Letter app runs (link page and bridge routes). Use
# scripts/mock-spoken-letter.mjs on :3007 until the Phase 3 bridge exists.
SPOKEN_LETTER_ORIGIN=http://localhost:3007

# Shared with the private app (ALEXA_BRIDGE_SECRET there too). Generated at startup when unset.
ALEXA_BRIDGE_SECRET=

# fixtures: every subject sees the Owner's recordings. auto: real uids go to the bridge.
PROVIDER_MODE=fixtures
FIXTURES_PATH=fixtures/stories.json

# Optional static bearer for curl and Amazon's Local Inspector. JWTs are always accepted.
MCP_DEV_TOKEN=

# JSON array of static clients; local dev clients (simulator, alexa-m2m) are generated when unset.
OAUTH_CLIENTS=
OAUTH_STORE=memory
OAUTH_TABLE=sla-oauth
JWT_SIGNER=local
KMS_KEY_ID=
AWS_REGION=us-east-1

# 1 mounts /dev/start and /dev/callback (finishes the code exchange without the simulator). Never in AWS.
DEV_ROUTES=1

# 1 serves 2025-era clients through per-session transports (Local Inspector contingency, amazon/inspector.md).
MCP_LEGACY_SESSIONS=0

# Set by CDK on Lambda only: CloudWatch EMF namespace for the ToolLatencyMs metric.
# EMF_NAMESPACE=sla/mcp
