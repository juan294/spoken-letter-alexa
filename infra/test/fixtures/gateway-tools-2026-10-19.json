[
  {
    "name": "spoken-letter___get_family_story",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "storyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Story id from list_family_stories"
        }
      },
      "required": [
        "storyId"
      ]
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "storyteller": {
          "type": "string"
        },
        "durationSeconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "deliveredAt": {
          "type": "string"
        },
        "audio": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "expiresAt": {
              "type": "string"
            },
            "contentType": {
              "type": "string",
              "const": "audio/mpeg"
            }
          },
          "required": [
            "url",
            "expiresAt",
            "contentType"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "title",
        "storyteller",
        "deliveredAt",
        "audio"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "spoken-letter___list_family_stories",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "limit": {
          "description": "How many stories to return, newest first (default 10)",
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "stories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "storyteller": {
                "type": "string"
              },
              "durationSeconds": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "deliveredAt": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "storyteller",
              "deliveredAt"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "stories"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "spoken-letter___suggest_next_story",
    "inputSchema": {
      "type": "object",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {}
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "story": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "storyteller": {
                  "type": "string"
                },
                "durationSeconds": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "deliveredAt": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "storyteller",
                "deliveredAt"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "story",
        "reason"
      ],
      "additionalProperties": false
    }
  }
]
