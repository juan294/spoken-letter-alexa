{
  "name": "infra",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "synth": "node scripts/bundle-lambda.mjs && cdk synth --quiet",
    "deploy": "cdk deploy --all --require-approval broadening --profile archy",
    "seed:secrets": "node scripts/seed-secrets.mjs",
    "build": "node scripts/bundle-lambda.mjs",
    "verify:gateway": "tsx scripts/verify-gateway.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore-control": "3.1153.0",
    "@aws-sdk/client-secrets-manager": "3.1153.0",
    "@spoken-letter-alexa/agent": "workspace:*",
    "aws-cdk-lib": "2.273.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "aws-cdk": "2.1146.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
